;; quarry-tier1.sb — containment for every process that reads target bytes.
;;
;; Honest scope (Seat 5): this is still an `(allow default)` profile with deny rules on
;; top, not a full jail. Anything needing a real jail goes to Tier 2 (Colima), see
;; docs/PLAN.md §4.1. What it blocks: egress, credential read, host-file read, host
;; write, and every per-user system service reached by name (clipboard, LaunchServices,
;; cfprefsd, launchd job submission).
;;
;; One gap no SBPL rule closes: launchd itself is reached through the bootstrap port,
;; not by a mach-lookup, so `launchctl print` works under any profile that lets the
;; binary run. Section 5 denies exec of /bin/launchctl (a relocated copy is killed by
;; the OS launch constraints, measured), but code execution inside a scanner can still
;; send raw messages to launchd. Domain listing is what that reaches; job creation is
;; denied by `job-creation`, and `launchctl submit` from inside the profile fails
;; (measured, before exec of launchctl was denied).
;;
;; Parameters: RUNDIR (the mounted per-run sparse image), HOSTHOME, TOOLSDIR, RULESDIR, DBDIR.
(version 1)
(allow default)

;; 1. No scanner has ever needed a socket.
(deny network*)

;; 2. No named system service. MEASURED: under the old single-service deny, `pbpaste`
;;    returned the operator's clipboard and `defaults write` reached cfprefsd. Every
;;    adapter (opengrep, bandit, checkov, gitleaks, zizmor, osv-scanner, trivy) plus
;;    syft, git and the venv python produced the same output with ZERO services
;;    allowed as under the old profile, so none are. Caveat: trivy and osv-scanner
;;    ran without a vulnerability DB (trivy misconfig/secret only); DB reads are plain
;;    file reads under DBDIR. Add a service back only with a tool that fails without it.
(deny mach-lookup)
(deny job-creation)
(deny user-preference-read user-preference-write)

;; 3. Signals only inside this sandbox. A scanner may reap its own workers; it may not
;;    kill or stop the orchestrator or anything else the operator runs.
(deny  signal)
(allow signal (target same-sandbox))

;; 4. The host filesystem is not readable. /Users is the operator; /private/tmp holds
;;    every other run's volume (/private/tmp/quarry/run-N) and the per-user launchd
;;    and ssh-agent socket dirs; /private/var/folders is every per-user temp and cache
;;    dir; /Volumes is every other mounted disk and image. The run volume is readable,
;;    and so is the one directory holding OUR tool binaries: those are ours, not the
;;    target's, and a venv under /Users would otherwise be unexecutable. Narrow and
;;    explicit.
(deny  file-read* (subpath "/Users")
                  (subpath "/private/tmp")
                  (subpath "/private/var/folders")
                  (subpath "/Volumes"))
(allow file-read* (subpath (param "RUNDIR")))
(allow file-read-metadata (path-ancestors (param "RUNDIR")))
(allow file-read* (subpath (param "TOOLSDIR")))
;;    Path resolution needs search on the ancestors of TOOLSDIR. `path-ancestors`
;;    grants metadata ONLY on that exact chain — not contents, and not siblings.
;;    Verified: with this rule ~/.ssh is still "Operation not permitted" to both
;;    cat and ls.
(allow file-read-metadata (path-ancestors (param "TOOLSDIR")))
(allow file-read* (subpath (param "RULESDIR")))
(allow file-read-metadata (path-ancestors (param "RULESDIR")))
(allow file-read* (subpath (param "DBDIR")))
(allow file-read-metadata (path-ancestors (param "DBDIR")))

;; 5. Belt and braces: name the crown jewels so a future (allow) cannot silently re-expose them.
(deny file-read*  (subpath (string-append (param "HOSTHOME") "/.ssh"))
                  (subpath (string-append (param "HOSTHOME") "/.aws"))
                  (subpath (string-append (param "HOSTHOME") "/.gnupg"))
                  (subpath (string-append (param "HOSTHOME") "/.config"))
                  (subpath (string-append (param "HOSTHOME") "/Library/Keychains")))
;;    Target bytes are read, never executed: nothing under src/ or quarantine/ runs.
;;    Not all of RUNDIR, because opengrep unpacks itself into $TMPDIR (RUNDIR/cache)
;;    and execs from there (measured: "couldn't launch child (exec)").
(deny process-exec (literal "/bin/launchctl")
                   (subpath (string-append (param "RUNDIR") "/src"))
                   (subpath (string-append (param "RUNDIR") "/quarantine")))

;; 6. Write only inside the run volume.
(deny  file-write*)
(allow file-write* (subpath (param "RUNDIR"))
                   (literal "/dev/null") (literal "/dev/stdout") (literal "/dev/stderr"))
